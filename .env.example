# Vite loads .env automatically. Export variables for the Python indexing scripts.
# Only the endpoint, collection and search-only key are written to the browser.
TYPESENSE_URL=https://your-cluster.a1.typesense.net
TYPESENSE_ADMIN_KEY=your-private-admin-key
TYPESENSE_COLLECTION=compendium
TYPESENSE_SEARCH_KEY=your-public-search-only-key
# Optional browser endpoint when indexing uses an internal address (e.g. Docker).
# TYPESENSE_PUBLIC_URL=http://localhost:8108
